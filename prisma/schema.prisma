generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  username        String   @unique
  email           String   @unique
  password        String
  role            String   @default("USER")
  isEmailVerified Boolean  @default(false)
  lockedUntil     DateTime?      // Account lockout
  deletedAt       DateTime?      // Soft delete (skip in queries)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[]
  emailTokens     EmailToken[]
  productReviews  ProductReview[]
  orders          Order[]
  cartItems       CartItem[]

  @@map("users")
  @@index([role])
  @@index([lockedUntil])
  @@index([deletedAt])
  @@index([isEmailVerified])
}

model RefreshToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String
  revoked     Boolean  @default(false)
  replacedBy  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String
  purpose   String   // VERIFY_EMAIL | FORGOT_PASSWORD | OTP
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

type Image{
  url   String?
  public_url   String?
}
type ProductSize{
  size String
  qty Int
  price Float
  sold Int @default(0)
}
type SubProduct{
  suk String?
  images String[]
  description_images String[]
  sizes ProductSize[]
  discount Float? @default(0)
  sold Int?  @default(0)
}
model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  description String
  longDescription String
  brand     String?
  sku       String   @unique
  rating    Float    @default(0)
  numReviews Int     @default(0)
  featured  Boolean  @default(false)
  discount  Float?   @default(0)
  sold      Int      @default(0)
  images          Image[]
  description_images Image[]
  ingredients Json   // ProductIngredient[]
  sizes           ProductSize[]
  subProducts     SubProduct[]

  categoryId String  @db.ObjectId
  category  Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  productReviews ProductReview[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  deletedAt DateTime? // Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  featured  Boolean  @default(false)
  deletedAt DateTime? // Soft delete 

  // Self-referential relationship for nested categories
  parentCategoryId String?  @db.ObjectId
  parentCategory   Category? @relation("SubCategories", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[] @relation("SubCategories")

  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
  @@index([parentCategoryId])
  @@index([deletedAt])
}

model SubCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
}

model ProductReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float      @default(0)
  comment   String
  deletedAt DateTime? // Soft delete

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productReviews")
  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int      @default(1)
  price     Float    // Price at time of adding to cart
  selectedSize String? // Selected product size if applicable

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cartItems")
  @@unique([productId, userId, selectedSize])
  @@index([userId])
}

model Order {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber  String   @unique // User-friendly order ID
  status       String   @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  paymentStatus String  @default("UNPAID") // UNPAID | PAID | FAILED | REFUNDED
  totalAmount  Float
  taxAmount    Float    @default(0)
  shippingAmount Float  @default(0)
  discountAmount Float  @default(0)

  // Shipping info
  shippingAddress String
  billingAddress String?
  phoneNumber    String

  // Payment info
  paymentMethod  String? // CARD | UPI | NET_BANKING | COD
  transactionId  String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveredAt DateTime?

  @@map("orders")
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Float   // Price at time of purchase
  size     String? // Selected size if applicable

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("orderItems")  
  @@index([orderId])
  @@index([productId])
}
