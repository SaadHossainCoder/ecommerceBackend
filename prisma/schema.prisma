generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  username        String   @unique
  email           String   @unique
  password        String
  role            Role   @default(USER)
  isEmailVerified Boolean  @default(false)
  lockedUntil     DateTime?      // Account lockout
  deletedAt       DateTime?      // Soft delete (skip in queries)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[] @relation("UserRefreshTokens")
  emailTokens     EmailToken[] @relation("UserEmailTokens")
  productReviews  ProductReview[]@relation("UserProductReviews")
  orders          Order[] @relation("UserOrders")
  cartItems       CartItem[]@relation("UserCartItems")
  addresses       Address[]  @relation("UserAddresses")
  couponIds       String[] @db.ObjectId
  couponsUsed     Coupon[] @relation("UserCoupons",fields: [couponIds], references: [id])


  @@map("users")
  @@index([role])
  @@index([lockedUntil])
  @@index([deletedAt])
  @@index([isEmailVerified])
}

model RefreshToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String
  revoked     Boolean  @default(false)
  replacedBy  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserRefreshTokens",fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum TokenPurpose {
  VERIFY_EMAIL
  FORGOT_PASSWORD
  OTP
}

model EmailToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String
  purpose   TokenPurpose // VERIFY_EMAIL | FORGOT_PASSWORD | OTP
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserEmailTokens",fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

type Image{
  url   String?
  publicUrl   String?
}
type ProductSize{
  size String
  qty Int
  price Float
  sold Int @default(0)
}
type SubProduct{
  sku String?
  images Image[]
  descriptionImages Image[]
  sizes ProductSize[]
  discount Float? @default(0)
  sold Int?  @default(0)
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  description String
  longDescription String
  productIsAvailable Boolean  @default(true)
  sku       String   @unique
  rating    Float    @default(0)
  numReviews Int     @default(0)
  featured  Boolean  @default(false)
  discount  Float?   @default(0)
  sold      Int      @default(0)
  images          Image[]
  descriptionImages Image[]
  ingredients Json   // ProductIngredient[]
  sizes           ProductSize[]
  subProducts     SubProduct[]

  vendorId String @db.ObjectId
  vendor   Vendor @relation("VendorProducts",fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId String  @db.ObjectId
  category  Category @relation("CategoryProducts",fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  productReviews ProductReview[] @relation("UserProductReviews")
  cartItems      CartItem[] @relation("UserCartItems")
  orderItems     OrderItem[] @relation("ProductOrderItems")

  deletedAt DateTime? // Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
  @@index([categoryId])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([productIsAvailable])
}

model Vendor{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  description String
  longDescription String
  images          Image[]
  descriptionImages Image[]
  vendorProductType String
  products Product[] @relation("VendorProducts")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendors")
  @@index([createdAt(sort: Desc)])
  
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  featured  Boolean  @default(false)
  deletedAt DateTime? // Soft delete 

  // Self-referential relationship for nested categories
  parentCategoryId String?  @db.ObjectId
  parentCategory   Category? @relation("SubCategories", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[] @relation("SubCategories")

  products  Product[] @relation("CategoryProducts")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
  @@index([parentCategoryId])
  @@index([deletedAt])
}


model ProductReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float      @default(0)
  comment   String
  isApproved Boolean  @default(false)
  
  deletedAt DateTime? // Soft delete

  productId String  @db.ObjectId
  product   Product @relation("UserProductReviews",fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserProductReviews",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productReviews")
  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int      @default(1)
  price     Float    // Price at time of adding to cart
  selectedSize String? // Selected product size if applicable

  productId String  @db.ObjectId
  product   Product @relation("UserCartItems",fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserCartItems",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cartItems")
  @@unique([productId, userId, selectedSize])
  @@index([userId])
}

// Use enums:
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod{
  CARD
  UPI
  NET_BANKING
  COD
}

type ShippingAddress{
  name String
  phone String
  address String
  city String
  state String
  postalCode String
  country String
}

model Order {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber  String   @unique // User-friendly order ID
  status       OrderStatus   @default(PENDING) // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  paymentStatus PaymentStatus  @default(UNPAID) // UNPAID | PAID | FAILED | REFUNDED
  totalAmount  Float
  taxAmount    Float    @default(0)
  shippingAmount Float  @default(0)
  discountAmount Float  @default(0)

  // Shipping info
  shippingAddress ShippingAddress[]
  
  // Payment info
  paymentMethod  PaymentMethod? // CARD | UPI | NET_BANKING | COD
  transactionId  String?

  userId String @db.ObjectId
  user   User   @relation("UserOrders",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderItems OrderItem[] @relation("OrderOrderItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveredAt DateTime?

  @@map("orders")
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Float   // Price at time of purchase
  size     String? // Selected size if applicable

  productId String  @db.ObjectId
  product   Product @relation("ProductOrderItems",fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orderId String @db.ObjectId
  order   Order  @relation("OrderOrderItems",fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("orderItems")  
  @@index([orderId])
  @@index([productId])
}

enum AddressType {
  myAddress
  giftAddress
}
model Address{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  street    String
  city      String
  state     String
  postalCode String
  country   String
  addressType AddressType // MY ADDRESS | GIFT ADDRESS
  name      String? // Recipient name for gift address
  phone     String? // Recipient phone number for gift address
  description String? // Optional description or label for the address

  userId String @db.ObjectId
  user   User   @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
  @@index([userId])
}

enum BannerType {
  HOME
  CATEGORY
  PRODUCT
}

type BannerLink{
  type BannerType
  id String? @db.ObjectId
  url String?
}

model Banner{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  description String
  image     Image
  link      BannerLink
  type      BannerType @default(HOME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model topBarNotification{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notificationBars")
}


model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  description String?
  maxDiscountAmount Float? // For percentage discounts, cap the maximum discount
  minPurchaseAmount Float? // Minimum order amount to apply coupon
  validFrom   DateTime
  validUntil  DateTime
  usageLimit  Int?     // Total times this coupon can be used across all users
  perUserLimit Int?    // Times a single user can use this coupon

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userIds     String[] @db.ObjectId
  users       User[]   @relation("UserCoupons",fields: [userIds], references: [id])

  @@map("coupons")
}


