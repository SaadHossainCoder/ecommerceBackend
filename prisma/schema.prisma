generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  username        String   @unique
  email           String   @unique
  password        String
  role            Role   @default(USER) 
  isEmailVerified Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  lockedUntil     DateTime?      // Account lockout
  deletedAt       DateTime?      // Soft delete (skip in queries)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokens   RefreshToken[] @relation("UserRefreshTokens")
  emailTokens     EmailToken[] @relation("UserEmailTokens")
  productReviews  ProductReview[]@relation("UserProductReviews")
  orders          Order[] @relation("UserOrders")
  cartItems       CartItem[]@relation("UserCartItems")
  addresses       Address[]  @relation("UserAddresses")
  couponIds       String[] @db.ObjectId
  couponsUsed     Coupon[] @relation("UserCoupons",fields: [couponIds], references: [id])


  @@map("users")
  @@index([role])
  @@index([lockedUntil])
  @@index([deletedAt])
  @@index([isEmailVerified])
}

model RefreshToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String
  revoked     Boolean  @default(false)
  replacedBy  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserRefreshTokens",fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

enum TokenPurpose {
  VERIFY_EMAIL
  FORGOT_PASSWORD
  OTP
}

model EmailToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String
  purpose   TokenPurpose // VERIFY_EMAIL | FORGOT_PASSWORD | OTP
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   User   @relation("UserEmailTokens",fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

type Image{
  url   String?
  publicUrl   String?
}
type ProductSize{
  size String
  qty Int
  price Int
  sold Int @default(0)
}
type SubProduct{
  sku String?
  images String[]
  descriptionImages String[]
  sizes ProductSize[]
  discount Int? @default(0)
  sold Int?  @default(0)
}

model Product {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  slug      String   @unique
  description String
  longDescription String
  productIsAvailable Boolean  @default(true)
  sku       String   @unique
  rating    Int    @default(0)
  numReviews Int     @default(0)
  featured  Boolean  @default(false)
  discount  Int?   @default(0)
  sold      Int      @default(0)
  images          String[]
  descriptionImages String[]
  ingredients Json   // ProductIngredient[]
  sizes           ProductSize[]
  subProducts     SubProduct[]

  vendorId String @db.ObjectId
  vendor   Vendor @relation("VendorProducts",fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  categoryId String  @db.ObjectId
  category  Category @relation("CategoryProducts",fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  productReviews ProductReview[] @relation("UserProductReviews")
  cartItems      CartItem[] @relation("UserCartItems")
  orderItems     OrderItem[] @relation("ProductOrderItems")
  coupons        Coupon[]

  deletedAt DateTime? // Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
  @@index([categoryId])
  @@index([title])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([productIsAvailable])
}

model Vendor{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  description String
  longDescription String
  images          String[]
  descriptionImages String[]
  vendorProductType String
  products Product[] @relation("VendorProducts")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendors")
  @@index([createdAt(sort: Desc)])
  
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String
  icon      String   @default("📁")
  featured  Boolean  @default(false)


  // Self-referential relationship for nested categories
  parentCategoryId String?  @db.ObjectId
  parentCategory   Category? @relation("SubCategories", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subCategories    Category[] @relation("SubCategories")

  products  Product[] @relation("CategoryProducts")
  coupons   Coupon[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
  @@index([parentCategoryId])
}


model ProductReview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Float      @default(0)
  comment   String
  isApproved Boolean  @default(false)

  productId String  @db.ObjectId
  product   Product @relation("UserProductReviews",fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserProductReviews",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("productReviews")
  @@unique([productId, userId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  quantity  Int      @default(1)
  price     Int    // snapshot price

  selectedSize String?

  isSelected Boolean @default(true)

  productId String  @db.ObjectId
  product   Product @relation("UserCartItems", fields: [productId], references: [id], onDelete: NoAction)

  userId String @db.ObjectId
  user   User   @relation("UserCartItems", fields: [userId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId, selectedSize])
  @@index([userId])
  @@index([deletedAt])
}
// Use enums:
enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod{
  CARD
  UPI
  NET_BANKING
  COD
}

type ShippingAddress{
  name String
  phone String
  address String
  city String
  state String
  postalCode String
  country String
}

model Order {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber  String   @unique // User-friendly order ID
  status       OrderStatus   @default(PENDING) // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  paymentStatus PaymentStatus  @default(UNPAID) // UNPAID | PAID | FAILED | REFUNDED
  totalAmount  Int
  taxAmount    Int    @default(0)
  shippingAmount Int  @default(0)
  discountAmount Int  @default(0)

  // Shipping info
  shippingAddress ShippingAddress[]
  
  // Payment info
  paymentMethod  PaymentMethod? // CARD | UPI | NET_BANKING | COD
  transactionId  String?

  userId String @db.ObjectId
  user   User   @relation("UserOrders",fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderItems OrderItem[] @relation("OrderOrderItems")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveredAt DateTime?

  @@map("orders")
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Int   // Price at time of purchase
  size     String? // Selected size if applicable

  productId String  @db.ObjectId
  product   Product @relation("ProductOrderItems",fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  orderId String @db.ObjectId
  order   Order  @relation("OrderOrderItems",fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("orderItems")  
  @@index([orderId])
  @@index([productId])
}

enum AddressType {
  MY_ADDRESS
  GIFT_ADDRESS
}

model Address {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  name      String
  phone     String
  email     String?

  street    String
  city      String
  state     String
  postalCode String
  country   String

  label     String? // Home, Office
  isDefault Boolean @default(false)

  addressType AddressType

  // 🎁 Gift fields
  friendName      String?
  friendPhone     String?
  giftDescription String?

  // 👤 User relation
  userId String @db.ObjectId
  user   User   @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)

  // 🧹 Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
  @@index([userId])
  @@index([deletedAt])
}

enum BannerType {
  HOME
  CATEGORY
  PRODUCT
}

type BannerLink{
  type BannerType
  id String? @db.ObjectId
  url String?
}

model Banner{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  description String
  image     String?
  link      String?
  type      BannerType @default(HOME)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model TopBarNotification{
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notificationBars")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
  USER
}


model Coupon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  code        String   @unique
  description String?

  // 🔥 Discount Type
  discountType DiscountType
  discountValue Int

  // 💰 Limits
  maxDiscountAmount Int?   // Cap for % discount
  minPurchaseAmount Int?   // Minimum cart value

  // ⏳ Validity
  validFrom   DateTime
  validUntil  DateTime

  // 🔢 Usage Control
  usageLimit   Int?   // Total usage
  usedCount    Int    @default(0)

  perUserLimit Int?   // Per user usage

  // 🔒 Status
  isActive Boolean @default(true)

  // 🎯 Scope (Optional)
  applicableTo CouponScope @default(ALL)

  // 👤 User restriction (optional)
  userIds String[] @db.ObjectId
  users   User[]   @relation("UserCoupons", fields: [userIds], references: [id])

  // 📦 Optional: Apply to category/product
  categoryId String? @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  productId String? @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validFrom, validUntil])
  @@index([isActive])
  @@map("coupons")
}


